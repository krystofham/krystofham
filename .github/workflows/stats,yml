name: Update README cards

on:
  schedule:
    - cron: "0 0 * * *" # Spustí se každý den o půlnoci
  workflow_dispatch: # Umožní ruční spuštění přes GitHub UI

jobs:
  build:
    runs-on: ubuntu-latest
    permissions:
      contents: write

    steps:
      - uses: actions/checkout@v4

      - name: Generate top languages card
        uses: stats-organization/github-readme-stats-action@v2
        with:
          card: top-langs
          options: username=${{ github.repository_owner }}&layout=compact&exclude_repo=prednasky-a-zapisy
          path: profile/top-langs.svg
          token: ${{ secrets.PAT_FOR_STATS }} # Použití vašeho nového tokenu

      - name: Commit cards
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]"
          git add profile/*.svg
          git commit -m "Update README cards" || exit 0
          git push